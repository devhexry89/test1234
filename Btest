    local MobileLibrary = LoadMobileLibrary()

    --[[ 
        MOBILE ADAPTER
        Uses the second UI implementation on touch-only devices while exposing
        the same public API as UIsource so scripts do not need separate code.
    ]]
    local MobileBeacon = {}
    MobileBeacon.__index = MobileBeacon
    local MobileTab = {}
    MobileTab.__index = MobileTab
    local MobilePanel = {}
    MobilePanel.__index = MobilePanel

    local MOBILE_ACCENT = Color3.fromRGB(145, 70, 255)
    local MOBILE_LIGHT_ACCENT = Color3.fromRGB(195, 145, 255)

    local function mobileCall(obj, method, ...)
        if obj and type(obj[method]) == "function" then
            return obj[method](obj, ...)
        end
    end

    local function forceVisible(instance, visible)
        if instance then
            pcall(function()
                instance.Visible = visible
            end)
        end
    end

    function MobileBeacon:CreateWindow(cfg)
        cfg = cfg or {}

        local mw = MobileLibrary:Window({
            Logo = "107169570033825",
            Size = cfg.Size,
            FadeSpeed = cfg.FadeSpeed or cfg.fadespeed,
            PagePadding = cfg.PagePadding or cfg.pagepadding,
        })

        -- Force the mobile library's accent to purple after construction so
        -- every themed item uses the same accent, including scrollbars,
        -- buttons, sliders, selected tabs and dropdown selections.
        pcall(function()
            MobileLibrary:ChangeTheme("Accent", MOBILE_ACCENT)
            MobileLibrary:ChangeTheme("Light Accent", MOBILE_LIGHT_ACCENT)
        end)

        local self = setmetatable({
            _mobile = mw,
            Tabs = {},
            Active = nil,
            _toggleKey = cfg.ToggleKey or Enum.KeyCode.P,
            _paletteKey = cfg.PaletteKey or Enum.KeyCode.Semicolon,
            _shown = mw.IsOpen ~= false,
            _destroyed = false,
            _theme = (type(cfg.Theme) == "string" and cfg.Theme) or "Default",
        }, MobileBeacon)

        local UIS = game:GetService("UserInputService")

        self._toggleConnection = UIS.InputBegan:Connect(function(input, gpe)
            if gpe or self._rebinding then return end
            if self._toggleKey
                and input.UserInputType == Enum.UserInputType.Keyboard
                and input.KeyCode == self._toggleKey then
                self:Toggle()
            end
        end)

        return self
    end

    function MobileBeacon:SetVisible(v)
        self._shown = v and true or false
        if self._mobile and self._mobile.SetOpen then
            self._mobile:SetOpen(self._shown)
        end
    end

    function MobileBeacon:Toggle()
        self:SetVisible(not self._shown)
    end

    function MobileBeacon:Show()
        self:SetVisible(true)
    end

    function MobileBeacon:Hide()
        self:SetVisible(false)
    end

    function MobileBeacon:IsVisible()
        return self._shown
    end

    function MobileBeacon:GetToggleKey()
        return self._toggleKey
    end

    function MobileBeacon:SetToggleKey(key)
        self._toggleKey = key
        if self._onToggleKeyChanged then
            pcall(self._onToggleKeyChanged, key)
        end
    end

    function MobileBeacon:SetPaletteKey(key)
        self._paletteKey = key
    end

    function MobileBeacon:SetTheme(name)
        self._theme = name or "Default"
        -- Keep Beacon API parity while ensuring the mobile UI remains purple.
        pcall(function()
            MobileLibrary:ChangeTheme("Accent", MOBILE_ACCENT)
            MobileLibrary:ChangeTheme("Light Accent", MOBILE_LIGHT_ACCENT)
        end)
    end

    function MobileBeacon:GetTheme()
        return self._theme
    end

    function MobileBeacon.GetThemes()
        return {"Default"}
    end

    function MobileBeacon.RegisterTheme(name, palette)
        -- API compatibility with desktop Beacon.
    end

    function MobileBeacon:TogglePalette() end
    function MobileBeacon:OpenPalette() end
    function MobileBeacon:ClosePalette() end

    -- Switch the actual Beacon tabs (Pages).  Do NOT create mobile SubPages:
    -- SubPages are a second navigation layer in the original mobile library,
    -- and leaving the second SubPage inactive makes later Beacon tabs appear
    -- blank. Beacon tabs map one-to-one to mobile Pages instead.
    function MobileBeacon:_selectTab(tab)
        if not tab or not tab.Page then
            return
        end

        local inline = self._mobile.Items and self._mobile.Items["Inline"]
        local unused = MobileLibrary.UnusedHolder

        -- These are the REAL mobile UI pages/tabs created by
        -- MobileLibrary:Page(). We switch those pages directly instead of
        -- using Beacon's desktop tab system or the mobile SubPage system.
        for _, other in ipairs(self.Tabs) do
            local page = other.Page
            local items = page and page.Items
            if items then
                local content = items["PageContent"] and items["PageContent"].Instance
                local button = items["Inactive"]

                if page == tab then
                    page.Active = true

                    if content then
                        pcall(function()
                            if inline and inline.Instance then
                                content.Parent = inline.Instance
                            end
                            content.Visible = true
                        end)
                    end

                    if button then
                        pcall(function()
                            button:Tween(nil, {ImageTransparency = 0})
                        end)
                    end
                else
                    page.Active = false

                    if content then
                        pcall(function()
                            content.Visible = false
                            if unused and unused.Instance then
                                content.Parent = unused.Instance
                            end
                        end)
                    end

                    if button then
                        pcall(function()
                            button:Tween(nil, {ImageTransparency = 0.5})
                        end)
                    end
                end
            end
        end

        self.Active = tab

        -- Re-apply the mobile accent after changing the actual page.
        pcall(function()
            MobileLibrary:ChangeTheme("Accent", MOBILE_ACCENT)
            MobileLibrary:ChangeTheme("Light Accent", MOBILE_LIGHT_ACCENT)
        end)
    end

    function MobileBeacon:CreateTab(cfg)
        cfg = cfg or {}

        local page = self._mobile:Page({
            Icon = cfg.Icon or "109391165290124",
            Search = cfg.Search or false,
        })

        local tab = setmetatable({
            Window = self,
            Page = page,
            Name = cfg.Name or "Tab",
            _mobile = page,
            _flip = 0,
        }, MobileTab)

        table.insert(self.Tabs, tab)

        -- Replace the library's page click behavior with Beacon-aware tab
        -- selection so the adapter always knows which tab is active.
        page._OnSelect = function()
            self:_selectTab(tab)
        end

        if not self.Active then
            self:_selectTab(tab)
        else
            forceVisible(page.Items and page.Items["PageContent"] and page.Items["PageContent"].Instance, false)
        end

        return tab
    end

    function MobileTab:Panel(title, opts)
        opts = opts or {}
        local side = opts.Side or ((self._flip % 2 == 0) and "Left" or "Right")
        self._flip = self._flip + 1

        -- Sections belong directly to the Page. This gives each Beacon tab
        -- its own independent left/right columns and avoids inactive SubPages.
        local section = self._mobile:Section({
            Name = title or "Panel",
            Side = side,
        })

        pcall(function()
            local pageContent = self.Page.Items["PageContent"]
            if pageContent and pageContent.Instance then
                pageContent.Instance.Visible = (self.Window.Active == self)
            end
            local sectionFrame = section.Items["Section"]
            if sectionFrame and sectionFrame.Instance then
                sectionFrame.Instance.Visible = true
            end
        end)

        return setmetatable({
            Window = self.Window,
            Tab = self,
            _mobile = section,
            Name = title or "Panel",
        }, MobilePanel)
    end

    function MobilePanel:Toggle(cfg)
        cfg = cfg or {}
        return self._mobile:Toggle({
            Name = cfg.Name or "Toggle",
            Flag = cfg.Flag,
            Default = cfg.Default == true,
            Callback = cfg.Callback,
        })
    end

    function MobilePanel:Button(cfg)
        cfg = cfg or {}
        return self._mobile:Button({
            Name = cfg.Name or "Button",
            Callback = cfg.Callback,
        })
    end

    function MobilePanel:Slider(cfg)
        cfg = cfg or {}
        local min = cfg.Min ~= nil and cfg.Min or 0
        local max = cfg.Max ~= nil and cfg.Max or 100
        local default = cfg.Default ~= nil and cfg.Default or min
        return self._mobile:Slider({
            Name = cfg.Name or "Slider",
            Flag = cfg.Flag,
            Min = min,
            Max = max,
            Default = default,
            Suffix = cfg.Suffix or "",
            Decimals = cfg.Decimals ~= nil and cfg.Decimals or 1,
            Callback = cfg.Callback,
        })
    end

    function MobilePanel:Dropdown(cfg)
        cfg = cfg or {}
        return self._mobile:Dropdown({
            Name = cfg.Name or "Dropdown",
            Flag = cfg.Flag,
            Items = cfg.Options or cfg.Items or {},
            Default = cfg.Default,
            MaxSize = cfg.MaxSize,
            Multi = cfg.Multi == true,
            Callback = cfg.Callback,
        })
    end

    function MobilePanel:Keybind(cfg)
        cfg = cfg or {}
        return self._mobile:Keybind({
            Name = cfg.Name or "Keybind",
            Flag = cfg.Flag,
            Default = cfg.Default or Enum.KeyCode.RightShift,
            Mode = cfg.Mode or "Toggle",
            Callback = cfg.Callback,
        })
    end

    function MobilePanel:MenuKeybind(cfg)
        cfg = cfg or {}
        local win = self.Window
        local current = cfg.Default or win._toggleKey
        if current then
            win:SetToggleKey(current)
        end

        local keybind = self._mobile:Keybind({
            Name = cfg.Name or "Menu Keybind",
            Default = current or Enum.KeyCode.RightShift,
            Mode = "Toggle",
            Callback = function(key)
                if typeof(key) == "EnumItem" then
                    win:SetToggleKey(key)
                end
                if cfg.Callback then
                    task.spawn(cfg.Callback, win._toggleKey)
                end
            end,
        })

        win._onToggleKeyChanged = function() end
        return keybind
    end

    function MobilePanel:Input(cfg)
        cfg = cfg or {}
        return self._mobile:Textbox({
            Name = cfg.Name or "Input",
            Flag = cfg.Flag,
            Default = cfg.Default or "",
            Placeholder = cfg.Placeholder or "",
            Callback = cfg.Callback,
        })
    end

    function MobilePanel:Label(text)
        return self._mobile:Label(text or "")
    end

    function MobilePanel:Paragraph(cfg)
        cfg = cfg or {}
        return self._mobile:Label(
            (cfg.Title and cfg.Title ~= "" and (cfg.Title .. "\n") or "") .. (cfg.Text or "")
        )
    end

    function MobileBeacon:Notify(cfg)
        cfg = cfg or {}
        if MobileLibrary.Notification then
            return MobileLibrary:Notification(
                cfg.Title or "Beacon",
                cfg.Text or "",
                cfg.Duration or 4
            )
        end
    end

    function MobileBeacon:Destroy()
        self._destroyed = true
        if self._toggleConnection then
            self._toggleConnection:Disconnect()
            self._toggleConnection = nil
        end
        if self._mobile and self._mobile.Items and self._mobile.Items.MainFrame then
            pcall(function()
                self._mobile.Items.MainFrame:Clean()
            end)
        end
    end

    return MobileBeacon
end

