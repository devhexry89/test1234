function Beacon:SetVisible(v)
		local hud = self.Hud
		self._shown = v
		local player = Players.LocalPlayer
		local cam = Workspace.CurrentCamera

		mdbg("SetVisible(", v, ") ENTER. cam=", cam, "CameraType(before)=", cam and cam.CameraType,
			"MouseBehavior(before)=", UserInputService.MouseBehavior,
			"MouseIconEnabled(before)=", UserInputService.MouseIconEnabled)

		if v then
			hud.Visible = true
			self._hudScale.Scale = 0.96
			tween(self._hudScale, POP, { Scale = 1 })

			-- Save old camera type and release mouse lock
			if player then
				local ok, err = pcall(function()
					self._oldCamType = cam.CameraType
					cam.CameraType = Enum.CameraType.Custom
				end)
				mdbg("Set cam.CameraType = Custom -> ok=", ok, "err=", err, "oldCamType=", self._oldCamType,
					"cam.CameraType now=", cam and cam.CameraType)
			else
				mdbg("No LocalPlayer found, skipped camera type change")
			end
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
			mdbg("Set MouseBehavior=Default, MouseIconEnabled=true. Now: MouseBehavior=",
				UserInputService.MouseBehavior, "MouseIconEnabled=", UserInputService.MouseIconEnabled)

			-- Most custom first-person camera scripts re-lock the mouse via a
			-- plain RunService.RenderStepped:Connect(...) callback. Those always
			-- run AFTER every BindToRenderStep callback regardless of priority,
			-- so fighting them with BindToRenderStep alone can't win. Instead,
			-- react the instant MouseBehavior/MouseIconEnabled actually changes
			-- (property-changed signals fire synchronously, so this snaps the
			-- value back before anything else observes it) for as long as the
			-- menu is open, plus a per-frame backstop for extra safety.
			if self._mouseBehaviorConn then self._mouseBehaviorConn:Disconnect() end
			if self._mouseIconConn then self._mouseIconConn:Disconnect() end
			if self._camTypeConn then self._camTypeConn:Disconnect() end
			self._mouseBehaviorConn = UserInputService:GetPropertyChangedSignal("MouseBehavior"):Connect(function()
				mdbg("[signal] MouseBehavior changed ->", UserInputService.MouseBehavior, "shown=", self._shown)
				if self._shown and UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
					mdbg("[signal] correcting MouseBehavior back to Default")
					UserInputService.MouseBehavior = Enum.MouseBehavior.Default
				end
			end)
			self._mouseIconConn = UserInputService:GetPropertyChangedSignal("MouseIconEnabled"):Connect(function()
				mdbg("[signal] MouseIconEnabled changed ->", UserInputService.MouseIconEnabled, "shown=", self._shown)
				if self._shown and not UserInputService.MouseIconEnabled then
					mdbg("[signal] correcting MouseIconEnabled back to true")
					UserInputService.MouseIconEnabled = true
				end
			end)
			if cam then
				self._camTypeConn = cam:GetPropertyChangedSignal("CameraType"):Connect(function()
					mdbg("[signal] CameraType changed ->", cam.CameraType, "shown=", self._shown)
				end)
			end
			pcall(function() RunService:UnbindFromRenderStep(MOUSE_UNLOCK_BIND) end)
			local watchdogAccum = 0
			RunService:BindToRenderStep(MOUSE_UNLOCK_BIND, Enum.RenderPriority.Camera.Value + 1, function(dt)
				if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
					mdbg("[renderstep] MouseBehavior was", UserInputService.MouseBehavior, "- forcing Default")
					UserInputService.MouseBehavior = Enum.MouseBehavior.Default
				end
				if not UserInputService.MouseIconEnabled then
					mdbg("[renderstep] MouseIconEnabled was false - forcing true")
					UserInputService.MouseIconEnabled = true
				end
				watchdogAccum += dt or 0
				if watchdogAccum >= 1 then
					watchdogAccum = 0
					mdbg("[watchdog] MouseBehavior=", UserInputService.MouseBehavior,
						"MouseIconEnabled=", UserInputService.MouseIconEnabled,
						"CameraType=", cam and cam.CameraType,
						"CurrentCamera==cam?", Workspace.CurrentCamera == cam)
				end
			end)
		else
			tween(self._hudScale, QUICK, { Scale = 0.96 })
			task.delay(0.2, function() if not self._shown then hud.Visible = false end end)

			if self._mouseBehaviorConn then self._mouseBehaviorConn:Disconnect(); self._mouseBehaviorConn = nil end
			if self._mouseIconConn then self._mouseIconConn:Disconnect(); self._mouseIconConn = nil end
			if self._camTypeConn then self._camTypeConn:Disconnect(); self._camTypeConn = nil end
			pcall(function() RunService:UnbindFromRenderStep(MOUSE_UNLOCK_BIND) end)
			mdbg("Hidden: disconnected mouse watchdogs and unbound render step")

			-- Restore first-person lock
			if player then
				pcall(function()
					if self._oldCamType then
						cam.CameraType = self._oldCamType
					end
				end)
			end
			-- Restore normal Roblox mouse state when the UI is closed.
			-- The previous code forced LockCenter + hidden cursor here.
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
			mdbg("SetVisible(false) DONE. MouseBehavior=", UserInputService.MouseBehavior,
				"MouseIconEnabled=", UserInputService.MouseIconEnabled)
		end
	end
