                    local AlphaPositionX = MathClamp(self.Alpha, 0, 0.95)

                    Items["AlphaDragger"]:Tween(TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2New(AlphaPositionX, 0, 0, 2)})
                    self:Update()
