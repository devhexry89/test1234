		local gui = new("ScreenGui", { Name = "BeaconHUD", ResetOnSpawn = false,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 9999, IgnoreGuiInset = true })
		local player = Players.LocalPlayer
		protectGui(gui, player)
		return gui
	end
