	-- Parents the ScreenGui somewhere that survives a same-place "teleport to
	-- lobby" that wipes PlayerGui (a common pattern: the game just runs
	-- player.PlayerGui:ClearAllChildren() on zone change). Prefers a hidden,
	-- protected container the game's own cleanup code can't see or reach
	-- (gethui(), when the environment provides it), then CoreGui, then falls
	-- back to plain PlayerGui for normal LocalScript use where neither of
	-- those are writable.
	-- NOTE: this can't survive an actual TeleportService place-to-place
	-- teleport (different PlaceId) â€” that fully resets the Roblox client and
	-- every script, including this one, stops running. Nothing running
	-- inside the script can persist through that; the loader that injects
	-- this script needs to run again on the new place (e.g. an autoexec).
	local function protectGui(gui, player)
		if typeof(gethui) == "function" then
			local ok = pcall(function() gui.Parent = gethui() end)
			if ok and gui.Parent then return true end
		end
		local coreOk = pcall(function() gui.Parent = game:GetService("CoreGui") end)
		if coreOk and gui.Parent then return true end
		if player then
			local pgOk = pcall(function() gui.Parent = player:WaitForChild("PlayerGui") end)
			if pgOk and gui.Parent then return true end
			pcall(function() gui.Parent = player:FindFirstChildOfClass("PlayerGui") end)
		end
		return gui.Parent ~= nil
	end
