	local function fuzzy(query, text)
		query = string.lower(query); text = string.lower(text)
		if query == "" then return 0 end
		local qi, score, streak, lastHit = 1, 0, 0, -2
		for ti = 1, #text do
			if qi > #query then break end
			if string.sub(text, ti, ti) == string.sub(query, qi, qi) then
				streak = (ti == lastHit + 1) and streak + 1 or 0
				score += 10 + streak * 5 + (ti == 1 and 15 or 0)
				lastHit = ti; qi += 1
			end
		end
		if qi <= #query then return nil end
		return score - (#text * 0.1)
	end
